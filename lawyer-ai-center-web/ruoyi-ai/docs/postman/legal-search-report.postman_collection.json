{
  "info": {
    "name": "法律检索报告 MVP 验收",
    "description": "先执行 SQL 迁移并部署后端。填写 baseUrl/clientId/tokenA/tokenB，A/B 必须为不同用户。仅针对本次创建的报告进行测试。最后一组会逻辑删除该报告。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenA}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:6040",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenA",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenB",
      "value": "",
      "type": "string"
    },
    {
      "key": "reportId",
      "value": "",
      "type": "string"
    },
    {
      "key": "lawItemId",
      "value": "",
      "type": "string"
    },
    {
      "key": "caseItemId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tempItemId",
      "value": "",
      "type": "string"
    },
    {
      "key": "fileUrl",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "A 个人报告完整流程",
      "item": [
        {
          "name": "01 A 创建报告",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "clientid",
                "value": "{{clientId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/legal/report",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman 检索报告验收\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"业务成功\", function () { pm.expect(pm.response.json().code).to.eql(200); });",
                  "const result=pm.response.json(); pm.collectionVariables.set(\"reportId\", String(result.data.id));",
                  "pm.test(\"ID 为字符串\", () => pm.expect(typeof result.data.id).to.eql(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 A 修改背景与结论",
          "request": {
            "method": "PUT",
            "header": [
