                "key": "clientid",
                "value": "{{clientId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/legal/report/{{reportId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"background\": \"用于验证快照导出。\",\n  \"conclusion\": \"依次核查材料。\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"业务成功\", function () { pm.expect(pm.response.json().code).to.eql(200); });"
                ]
              }
            }
          ]
        },
